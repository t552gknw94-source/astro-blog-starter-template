---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Invite from "../components/Invite.astro";
import { pageTitle } from "../consts";

const description =
	"Teaching philosophy for 11th Grade English and AP Seminar: inquiry, writing, authentic assessment, and responsible technology.";
---

<BaseLayout title={pageTitle("Teaching")} description={description}>
	<PageHero
		eyebrow="Teaching"
		title="Creating classrooms where curiosity drives learning"
		lede="Real questions. Texts that resist an easy thesis. Time to revise."
	/>

	<section class="section" aria-labelledby="philosophy-heading">
		<div class="wrap measure prose">
			<h2 id="philosophy-heading">On a weekday</h2>
			<p>
				Curiosity is built, not waited for. Students meet a text or a set of sources that will not
				sit under one obvious claim. They notice what is strange before they prove a point.
			</p>
			<p>
				I choose the friction and coach the next move. A useful question is specific enough to
				research and open enough to argue. English and AP Seminar share that stance. The products
				differ.
			</p>
		</div>
	</section>

	<section class="section band-warm" aria-labelledby="pillars-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Instructional pillars</p>
				<h2 id="pillars-heading">Four commitments</h2>
			</div>
			<div class="stack">
				<article class="panel">
					<p class="kicker">01</p>
					<h3>Inquiry-Driven Instruction</h3>
					<p>
						Units open with a question students can own, then narrow, define, and defend why it is
						worth a reader’s time.
					</p>
					<ul>
						<li>Questions are revised before a thesis is allowed to harden.</li>
						<li>Discussion feeds the draft.</li>
						<li>Students record what evidence changed the question.</li>
					</ul>
				</article>

				<article class="panel" id="research-writing">
					<p class="kicker">02</p>
					<h3>Research &amp; Writing Mastery</h3>
					<p>
						A line of reasoning needs evidence that supports the point and commentary that shows
						how. You cannot write past a source you cannot use precisely.
					</p>
					<ul>
						<li>Claim, evidence, and commentary that earns the evidence.</li>
						<li>Summary is not analysis. A quotation is not proof.</li>
					</ul>
					<p>
						See the <a href="/resources#english">writing tools</a> and the
						<a href="/resources#ap-seminar">AP Seminar organizers</a>.
					</p>
				</article>

				<article class="panel">
					<p class="kicker">03</p>
					<h3>Authentic Assessment</h3>
					<p>
						Students are assessed on the thinking the course claims to teach: a literary argument,
						a researched report, a presentation, a record of how the idea changed.
					</p>
					<ul>
						<li>Models, criteria, and a revision window come first.</li>
						<li>Peer review stays specific.</li>
					</ul>
				</article>

				<article class="panel">
					<p class="kicker">04</p>
					<h3>Responsible AI &amp; Digital Literacy</h3>
					<p>
						Students already meet fluent, uncredited text. We evaluate sources, read laterally, and
						use tools, including generative AI, without handing over authorship.
					</p>
					<ul>
						<li>Live claims, not only pre-selected packets.</li>
						<li>AI use is disclosed and verified.</li>
						<li>Other students’ drafts stay out of the tool.</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<section class="section" id="courses" aria-labelledby="courses-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Course highlights</p>
				<h2 id="courses-heading">Two courses, one standard</h2>
			</div>
			<div class="split-even">
				<article class="panel">
					<p class="kicker">11th Grade English</p>
					<h3>Literature, rhetoric, and a writing life</h3>
					<p>Stay with a complicated text. Write an argument that shows you read it.</p>
					<ul>
						<li>Close reading for pattern, perspective, and purpose.</li>
						<li>Commentary, not plot summary.</li>
						<li>Discussion and peer review aimed at the line of reasoning.</li>
					</ul>
					<p>
						<a class="text-link" href="/resources#english">Classroom writing resources</a>
					</p>
				</article>
				<article class="panel">
					<p class="kicker">AP Seminar</p>
					<h3>Inquiry, in a team and alone</h3>
					<p>
						AP Capstone’s first course: investigate a real issue from more than one perspective,
						then argue in writing and aloud.
					</p>
					<ul>
						<li>QUEST as a working method.</li>
						<li>Performance tasks with scaffolds that fade.</li>
						<li>Presentations rehearsed for the questions that follow.</li>
					</ul>
					<p>
						<a class="text-link" href="/ap-seminar">A deeper look at AP Seminar</a>
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section band-warm">
		<div class="wrap measure prose">
			<h2>A rhythm students can count on</h2>
			<p>
				A week mixes reading, a short writing move, and talk. Students know when they are gathering,
				drafting, and revising. I would rather see a precise claim revised than a safe summary.
			</p>
		</div>
	</section>

	<Invite
		title="Use the classroom version"
		text="The resource library is free with attribution. Write if you want to adapt it with your department."
	/>
</BaseLayout>
