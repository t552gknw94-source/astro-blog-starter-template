---
import BaseLayout from "../layouts/BaseLayout.astro";
import Portrait from "../components/Portrait.astro";
import Invite from "../components/Invite.astro";
import { pageTitle } from "../consts";

const description =
	"Akai Milson teaches 11th Grade English and AP Seminar at Olympia High School and coaches varsity girls basketball.";
---

<BaseLayout title={pageTitle("About")} description={description}>
	<section class="about-intro">
		<div class="wrap split">
			<div class="stack">
				<p class="eyebrow">About</p>
				<h1>An English classroom built for thinking</h1>
				<p class="lede">
					11th Grade English and AP Seminar at Olympia High School. Curriculum design, and a close
					eye on the tools students already carry.
				</p>
				<div class="prose">
					<p>
						Both courses ask students to decide what they think, show the path, and stay open to
						being wrong.
					</p>
					<p>
						Administrators, parents, colleagues, and conference organizers get the same materials I
						put in students’ hands.
					</p>
				</div>
			</div>
			<Portrait size="aside" />
		</div>
	</section>

	<section class="section" aria-labelledby="court-heading">
		<div class="wrap teaser">
			<div>
				<p class="eyebrow">Basketball</p>
				<h2 id="court-heading">Also on the court</h2>
				<p class="lede">Head coach, varsity girls basketball, Olympia High School, Orlando.</p>
			</div>
			<a class="btn btn-secondary" href="/basketball">Coaching resume</a>
		</div>
	</section>

	<section class="section" aria-labelledby="mission-heading">
		<div class="wrap measure prose">
			<h2 id="mission-heading">The mission</h2>
			<p>
				Students should leave with a sharper question and a line of reasoning they can explain to
				someone who disagrees. Notice the complication. Read who has studied it. Weigh perspectives.
				Say it plainly.
			</p>
			<p>
				The same test applies to a unit, a conference, or a new tool. If it does not make thinking
				clearer, it does not stay.
			</p>
		</div>
	</section>

	<section class="section band-warm" aria-labelledby="design-heading">
		<div class="wrap split-even">
			<article class="panel">
				<p class="kicker">Curriculum design</p>
				<h2 id="design-heading">Backward from the thinking</h2>
				<p>
					Essays, discussions, research reports, and presentations practice the same moves:
					question, read across perspectives, use evidence, and argue for a real audience.
				</p>
				<p>
					A scaffold stays only until a student can make the move without it. The map has to work
					on a Tuesday.
				</p>
			</article>
			<article class="panel">
				<p class="kicker">Educational technology</p>
				<h2>Tools in service of judgment</h2>
				<p>
					I try a tool, including generative AI, against one question: does it show the thinking, or
					hide it inside a fluent answer?
				</p>
				<p>
					The <a href="/resources#ai-tech">AI and technology resources</a> state what is allowed,
					what must be disclosed, and what remains the student’s claim.
				</p>
			</article>
		</div>
	</section>

	<section class="section" aria-labelledby="collaborate-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Collaboration</p>
				<h2 id="collaborate-heading">Why people write</h2>
			</div>
			<div class="audience-grid">
				<article class="audience-card">
					<h3>Administrators</h3>
					<p>Curriculum alignment, classroom visits, and faculty learning teachers can use the same week.</p>
				</article>
				<article class="audience-card">
					<h3>Parents and guardians</h3>
					<p>Research tasks, feedback, and how to support a student without writing the paper.</p>
				</article>
				<article class="audience-card">
					<h3>Colleagues</h3>
					<p>Protocols, organizers, and visits. Take what is useful. Send back what is better.</p>
				</article>
				<article class="audience-card">
					<h3>Conference organizers</h3>
					<p>Workshops on fact-checking, AI-assisted research, and scaffolding academic writing.</p>
				</article>
			</div>
		</div>
	</section>

	<Invite />
</BaseLayout>
