---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../consts";
---

<BaseLayout
	title={pageTitle("Page not found")}
	description="That page is not on this site. The work is still here."
>
	<section class="empty-page wrap">
		<p class="eyebrow">404</p>
		<h1>This page is not in the binder</h1>
		<p class="lede">The link is out of date. The work is still here.</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="/">Back home</a>
			<a class="btn btn-secondary" href="/resources">Browse resources</a>
		</div>
	</section>
</BaseLayout>
