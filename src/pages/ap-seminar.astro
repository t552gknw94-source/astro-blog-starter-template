---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Invite from "../components/Invite.astro";
import { pageTitle } from "../consts";

const description =
	"How Akai Milson teaches AP Seminar: QUEST, the IRR and TMP, the IWA and IMP, and the research habits students practice.";

const steps = [
	{
		name: "Question and Explore",
		text: "Start with a real problem and narrow it. A usable question is researchable, debatable, and significant beyond the author.",
	},
	{
		name: "Understand and Analyze",
		text: "Name the argument: claim, line of reasoning, evidence, and assumptions. Notice whether the source reports, persuades, sells, advocates, or studies.",
	},
	{
		name: "Evaluate Multiple Perspectives",
		text: "Map who is speaking, what they value, what evidence they trust, and where the view runs out.",
	},
	{
		name: "Synthesize Ideas",
		text: "Put sources in conversation. Commentary builds a line of reasoning none of them made alone.",
	},
	{
		name: "Team, Transform, and Transmit",
		text: "Divide the inquiry without dividing the understanding. Then defend a question you did not script.",
	},
];

const skills = [
	{
		title: "Question design",
		text: "Moving from a topic to a question with a clear scope, definitions, and a reason to care.",
	},
	{
		title: "Lens discipline",
		text: "Choosing a perspective and staying with it long enough to say something precise.",
	},
	{
		title: "Source judgment",
		text: "Deciding what a source can prove, and what a second source does to that confidence.",
	},
	{
		title: "Line of reasoning",
		text: "Ordering claims so each one prepares the next, with evidence and commentary at every step.",
	},
	{
		title: "Collaboration",
		text: "Building a team argument that is shared, while each person’s research remains accountable.",
	},
	{
		title: "Oral defense",
		text: "Explaining a choice of evidence, a limitation, or a complication without retreating to the script.",
	},
];
---

<BaseLayout title={pageTitle("AP Seminar")} description={description}>
	<PageHero
		eyebrow="AP Seminar"
		title="Inquiry, argument, and the courage to revise"
		lede="Investigate a real question, read across perspectives, and argue in writing and aloud. The first course in AP Capstone."
	/>

	<section class="section">
		<div class="wrap measure prose">
			<h2>What students learn</h2>
			<p>
				College Board’s tasks, exam, and scoring guidelines govern the course. This page is the
				classroom map. Check the current materials for percentages, word counts, and timing before
				a submission.
			</p>
			<p>
				The published score draws on a team project and presentation, an individual research-based
				essay and presentation, and an end-of-course exam. Students work in teams and alone, then
				defend the argument out loud.
			</p>
		</div>
	</section>

	<section class="section band-warm" id="quest" aria-labelledby="quest-heading">
		<div class="wrap">
			<div class="section-head">
				<h2 id="quest-heading">The QUEST framework</h2>
				<p class="lede">A weekly method, not a poster. Students name the move they are in.</p>
			</div>
			<ol class="step-list">
				{
					steps.map((step, index) => (
						<li class="step">
							<span class="step-num">{index + 1}</span>
							<div>
								<h3>{step.name}</h3>
								<p>{step.text}</p>
							</div>
						</li>
					))
				}
			</ol>
			<p class="lede" style="margin-top:1.25rem">
				Early scaffold: the <a href="/resources/quest-planning-map/">QUEST planning map</a>.
			</p>
		</div>
	</section>

	<section class="section" id="performance-tasks" aria-labelledby="tasks-heading">
		<div class="wrap">
			<div class="section-head">
				<h2 id="tasks-heading">Performance tasks</h2>
				<p class="lede">Two tasks. Each pairs a written argument with a presentation.</p>
			</div>
			<div class="split-even">
				<article class="panel">
					<p class="kicker">Performance Task 1</p>
					<h3>Individual Research Report &amp; Team Multimedia Presentation</h3>
					<p>
						A team divides a real problem by lens. Each student writes an Individual Research
						Report, about 1,200 words in current course materials. The team then presents for about
						8 to 10 minutes and takes defense questions.
					</p>
					<p>The shared problem stays shared. One report has to change what another report can claim.</p>
					<ul>
						<li>Individual reports that a teammate can actually use.</li>
						<li>A team argument with a through-line, not five speeches taped together.</li>
						<li>Defense practice on limitations, evidence, and perspective.</li>
					</ul>
				</article>
				<article class="panel">
					<p class="kicker">Performance Task 2</p>
					<h3>Individual Written Argument &amp; Individual Multimedia Presentation</h3>
					<p>
						The Individual Written Argument uses stimulus materials plus the student’s sources,
						about 2,000 words in current course materials. The Individual Multimedia Presentation
						runs about 6 to 8 minutes, then an oral defense.
					</p>
					<p>
						Scaffolds come off. Use the
						<a href="/resources/stimulus-synthesis-organizer/">synthesis organizer</a> and the
						<a href="/resources/line-of-reasoning-checklist/">line of reasoning checklist</a> as
						revision tools, not in place of College Board’s rubric.
					</p>
					<ul>
						<li>A debatable claim that the stimulus materials complicate.</li>
						<li>Commentary that connects evidence back to the reason, every time.</li>
						<li>A presentation that a listener can follow without the paper in hand.</li>
					</ul>
				</article>
			</div>
			<article class="panel" style="margin-top:1rem">
				<p class="kicker">End-of-course exam</p>
				<h3>Reading an argument, then building one</h3>
					<p>
						Under time: short responses to an argument, then an evidence-based argument built from
						stimulus sources. We practice structure, not a template.
					</p>
			</article>
		</div>
	</section>

	<section class="section band-warm" id="college-skills" aria-labelledby="skills-heading">
		<div class="wrap">
			<div class="section-head">
				<h2 id="skills-heading">College-level research, practiced in high school</h2>
				<p class="lede">A bounded question, sources in context, and an argument the writer can explain aloud.</p>
			</div>
			<div class="skill-grid">
				{
					skills.map((skill) => (
						<article class="panel">
							<h3>{skill.title}</h3>
							<p>{skill.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap measure prose">
			<h2>How the scaffolding fades</h2>
			<p>
				Early tasks use the QUEST map, the stimulus organizer, commentary stems, and a team
				planner. Students know which supports will disappear. By the individual written argument,
				the question and the outline are theirs.
			</p>
			<p>
				Cite, paraphrase in your own structure, and disclose allowed tools. The thinking has to be
				work the student can defend in the room. Start with the
				<a href="/resources#ap-seminar">AP Seminar resources</a>, or
				<a href="/contact?interest=academic-writing">request a session</a>.
			</p>
		</div>
	</section>

	<Invite
		title="Planning AP Seminar?"
		text="Families, new teachers, and schools designing the Capstone sequence are welcome to write."
	/>
</BaseLayout>
