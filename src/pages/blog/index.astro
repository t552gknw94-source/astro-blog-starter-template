---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Invite from "../../components/Invite.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { pageTitle } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [feature, ...rest] = posts;

const description =
	"Essays on inquiry, sources, AP Seminar, 11th grade English, and writing with AI in the room.";
---

<BaseLayout title={pageTitle("Blog")} description={description}>
	<PageHero
		eyebrow="Blog"
		title="Notes from the classroom"
		lede="Inquiry, sources, academic writing, and judgment when the tools get faster."
	/>

	<section class="section">
		<div class="wrap post-list">
			{
				feature && (
					<article class="post-card post-feature">
						<p class="kicker">{feature.data.category}</p>
						<h2>
							<a href={`/blog/${feature.id}/`}>{feature.data.title}</a>
						</h2>
						<p>{feature.data.description}</p>
						<p class="byline">
							<FormattedDate date={feature.data.pubDate} />
						</p>
						<p>
							<a class="text-link" href={`/blog/${feature.id}/`}>
								Read the article
							</a>
						</p>
					</article>
				)
			}
			{
				rest.map((post) => (
					<article class="post-card">
						<p class="kicker">{post.data.category}</p>
						<h3>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h3>
						<p>{post.data.description}</p>
						<p class="byline">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</article>
				))
			}
		</div>
	</section>
	<Invite
		title="Take an idea into the classroom"
		text="The resource library holds the organizers, protocols, and norms."
	/>
</BaseLayout>
