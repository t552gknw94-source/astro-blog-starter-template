---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Invite from "../../components/Invite.astro";
import { pageTitle } from "../../consts";
import { getCollection } from "astro:content";

const resources = (await getCollection("resources")).sort((a, b) => a.data.order - b.data.order);

const categories = [
	{
		id: "ap-seminar",
		title: "AP Seminar Research & Argumentation",
		lede: "QUEST, stimulus packets, team presentations, and the line of reasoning.",
	},
	{
		id: "english",
		title: "11th Grade English & Writing",
		lede: "Literary analysis, academic paragraphs, and peer review.",
	},
	{
		id: "web-literacy",
		title: "Web Literacy & Fact-Checking",
		lede: "Who is behind a source, and what a second source does to the claim.",
	},
	{
		id: "ai-tech",
		title: "AI & Technology in the Classroom",
		lede: "Norms for tools that support the thinking and leave it with the student.",
	},
];

const description =
	"AP Seminar organizers, writing tools, web-literacy guides, and AI norms from Akai Milson.";
---

<BaseLayout title={pageTitle("Resources")} description={description}>
	<PageHero
		eyebrow="Resources"
		title="Frameworks students can hold"
		lede="Organizers and protocols for English and AP Seminar. Read, download, or print. Use with attribution."
	/>

	<section class="section">
		<div class="wrap stack" style="gap:3rem">
			{
				categories.map((category) => {
					const items = resources.filter((resource) => resource.data.categoryId === category.id);
					return (
						<section id={category.id} aria-labelledby={`${category.id}-heading`}>
							<div class="section-head">
								<h2 id={`${category.id}-heading`}>{category.title}</h2>
								<p class="lede">{category.lede}</p>
							</div>
							<div class="card-grid">
								{items.map((resource) => (
									<article class="resource-card">
										<div class="tag-row">
											<span class="tag">{resource.data.useLabel}</span>
											<span class="tag">{resource.data.audience}</span>
										</div>
										<h3>
											<a href={`/resources/${resource.id}/`}>{resource.data.title}</a>
										</h3>
										<p>{resource.data.description}</p>
										<div class="card-actions">
											<a href={`/resources/${resource.id}/`}>View</a>
											<a href={`/downloads/${resource.id}.md`}>Download</a>
										</div>
									</article>
								))}
							</div>
						</section>
					);
				})
			}
		</div>
	</section>

	<Invite
		title="Adapting a protocol?"
		text="These handouts are for students and the teachers who coach them."
	/>
</BaseLayout>
