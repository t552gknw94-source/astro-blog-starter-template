---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { pageTitle } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, category } = Astro.props;

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const related = posts.filter((post) => post.data.title !== title).slice(0, 2);
---

<BaseLayout title={pageTitle(title)} description={description}>
	<article>
		<header class="post-header">
			<div class="wrap hero-copy">
				<p class="eyebrow">{category}</p>
				<h1>{title}</h1>
				<p class="lede">{description}</p>
				<p class="byline">
					Akai Milson · <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<>
								{" "}
								· Updated <FormattedDate date={updatedDate} />
							</>
						)
					}
				</p>
			</div>
		</header>
		<div class="prose post-body">
			<slot />
			<aside class="author-card">
				<p class="eyebrow">About the author</p>
				<p>
					<strong>Akai Milson</strong> teaches 11th Grade English and AP Seminar at Olympia High School
					and designs curriculum around inquiry, writing, and a careful use of classroom technology.
				</p>
				<p><a href="/about">More about Akai</a></p>
			</aside>
		</div>
	</article>
	{
		related.length > 0 && (
			<section class="related" aria-labelledby="related-heading">
				<div class="wrap">
					<h2 id="related-heading">Continue reading</h2>
					<div class="card-grid" style="margin-top:1.25rem">
						{related.map((post) => (
							<article class="post-card">
								<p class="kicker">{post.data.category}</p>
								<h3>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p>{post.data.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>
