---
import { EMAIL, LINKEDIN_URL, MAXPREPS_URL, NAV_LINKS } from "../consts";
---

<footer class="site-footer">
	<div class="wrap footer-grid">
		<div class="footer-brand-block">
			<p class="footer-mark" aria-hidden="true">AM</p>
			<p class="footer-summary">Akai Milson — Helping Students Become Better Thinkers</p>
			<p class="footer-note">
				11th Grade English, AP Seminar, and varsity girls basketball at Olympia High School.
			</p>
		</div>
		<nav aria-label="Footer">
			<p class="footer-heading">Explore</p>
			<ul class="footer-links">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div>
			<p class="footer-heading">Connect</p>
			<ul class="footer-links">
				<li>
					<a href={LINKEDIN_URL} rel="noopener noreferrer" target="_blank">
						LinkedIn <span class="sr-only">(opens in a new tab)</span>
					</a>
				</li>
				<li><a href="/contact">Contact</a></li>
				<li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
				<li>
					<a href={MAXPREPS_URL} rel="noopener noreferrer" target="_blank">
						Olympia Girls Basketball on MaxPreps
						<span class="sr-only">(opens in a new tab)</span>
					</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="wrap footer-legal">
		<p>© 2026 Akai Milson. All rights reserved.</p>
	</div>
</footer>
