---
import HeaderLink from "./HeaderLink.astro";
import { NAV_LINKS } from "../consts";
---

<header class="site-header">
	<div class="brand-bar" aria-hidden="true"></div>
	<div class="wrap header-bar">
		<a class="brand" href="/">
			<span class="logo-mark" aria-hidden="true">AM</span>
			<span class="brand-text">
				<span class="brand-name">Akai Milson</span>
				<span class="brand-role">English &amp; AP Seminar</span>
			</span>
		</a>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
			<span class="sr-only">Open menu</span>
			<span class="nav-toggle-bars" aria-hidden="true"></span>
		</button>
		<nav id="primary-nav" class="primary-nav" aria-label="Primary">
			{
				NAV_LINKS.map((link) => (
					<HeaderLink href={link.href}>{link.label}</HeaderLink>
				))
			}
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const nav = document.getElementById("primary-nav");

	if (toggle && nav) {
		const label = toggle.querySelector(".sr-only");

		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", String(open));
			nav.classList.toggle("is-open", open);
			document.body.classList.toggle("nav-open", open);
			if (label) label.textContent = open ? "Close menu" : "Open menu";
		};

		toggle.addEventListener("click", () => {
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		nav.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});

		window.matchMedia("(min-width: 981px)").addEventListener("change", (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>
