---
import { EMAIL } from "../consts";

interface Props {
	title?: string;
	text?: string;
}

const {
	title = "Bring this work to your school or conference",
	text = "Administrators, families, colleagues, and conference organizers are welcome to write.",
} = Astro.props;
---

<section class="invite">
	<div class="wrap invite-inner">
		<div>
			<h2>{title}</h2>
			<p>{text}</p>
		</div>
		<div class="invite-actions">
			<a class="btn btn-light" href="/contact">Contact Akai</a>
			<a class="btn btn-ghost" href={`mailto:${EMAIL}`}>{EMAIL}</a>
		</div>
	</div>
</section>
