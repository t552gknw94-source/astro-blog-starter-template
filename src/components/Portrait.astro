---
/**
 * Square editorial portrait.
 * Add public/akai-portrait.jpg and rebuild to replace the monogram plate.
 */
interface Props {
	size?: "hero" | "aside";
}

const { size = "hero" } = Astro.props;
const hasPortrait = __HAS_PORTRAIT__;
---

<figure class:list={["portrait", size === "aside" && "portrait-aside"]}>
	<div class="portrait-frame">
		<div class="portrait-mat">
			<div class:list={["portrait-inner", hasPortrait && "has-photo"]}>
				{
					hasPortrait && (
						<img
							src="/akai-portrait.jpg"
							width="800"
							height="1000"
							alt="Portrait of Akai Milson"
							onerror="this.closest('.portrait-inner')?.classList.add('show-fallback'); this.remove();"
						/>
					)
				}
				<div class="portrait-fallback" aria-hidden={hasPortrait ? "true" : undefined}>
					<svg viewBox="0 0 640 800" role="img" aria-labelledby="portrait-title portrait-desc">
						<title id="portrait-title">Akai Milson</title>
						<desc id="portrait-desc">
							Editorial monogram used until a photograph is added at public/akai-portrait.jpg.
						</desc>
						<defs>
							<linearGradient id="plate" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0%" stop-color="#1a2740" />
								<stop offset="100%" stop-color="#0c121c" />
							</linearGradient>
						</defs>
						<rect width="640" height="800" fill="url(#plate)" />
						<rect x="28" y="28" width="584" height="744" fill="none" stroke="#C9A55C" stroke-width="1" />
						<text
							x="320"
							y="150"
							text-anchor="middle"
							fill="#C9A55C"
							font-family="Inter, sans-serif"
							font-size="13"
							font-weight="600"
							letter-spacing="5">OLYMPIA HIGH SCHOOL</text
						>
						<text
							x="320"
							y="340"
							text-anchor="middle"
							fill="#F5F1E8"
							font-family="Cormorant Garamond, Georgia, serif"
							font-size="108"
							font-weight="500">Akai</text
						>
						<text
							x="320"
							y="440"
							text-anchor="middle"
							fill="#F5F1E8"
							font-family="Cormorant Garamond, Georgia, serif"
							font-size="92"
							font-style="italic"
							font-weight="500">Milson</text
						>
						<line x1="230" y1="480" x2="410" y2="480" stroke="#C9A55C" stroke-width="1" />
						<text
							x="320"
							y="522"
							text-anchor="middle"
							fill="#C9C2B4"
							font-family="Inter, sans-serif"
							font-size="12"
							font-weight="600"
							letter-spacing="3.2">ENGLISH · AP SEMINAR</text
						>
						<g fill="none" stroke="#C9A55C" stroke-width="1.25">
							<path d="M230 600c36 16 62 16 90 0v86c-28 16-54 16-90 0z" />
							<path d="M410 600c-36 16-62 16-90 0v86c28 16 54 16 90 0z" />
						</g>
					</svg>
				</div>
			</div>
		</div>
	</div>
	<figcaption>
		<span class="portrait-name">Akai Milson</span>
		<span class="portrait-meta">11th Grade English · AP Seminar</span>
	</figcaption>
</figure>
